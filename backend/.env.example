# GitSummarizer Backend Environment Variables

# External API Credentials
# GitHub personal access token (optional, but recommended to avoid 60 requests/hr rate limit)
GITHUB_TOKEN=your_github_token_here

# OpenAI API key (required for LLM summaries)
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model to use (e.g. gpt-4o-mini, gpt-4o)
OPENAI_MODEL=gpt-4o-mini

# Database Configuration (SQLite by default)
DATABASE_URL=sqlite:///./git_summarizer.db

# Frontend CORS Origin (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173

# Application Settings
DEBUG=False
API_V1_PREFIX=/api/v1
REQUEST_TIMEOUT_SECONDS=15.0
MAX_README_CHARS=15000
MAX_DIFF_CHARS=12000

